<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/MainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark">

    <LinearLayout
        android:id="@+id/HomeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/peak_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingLeft="32dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/home_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE"
                    android:format24Hour="EEEE"
                    android:textColor="@color/on_surface_dark"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="MMMM d"
                    android:format24Hour="MMMM d"
                    android:textColor="@color/on_surface_dark"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="bottom|end"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/weather_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/command_accent"
                    android:textSize="12sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/battery_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <me.pompel.elauncher.ActivityBarView
            android:id="@+id/activity_bar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:paddingLeft="1dp"
            android:paddingRight="1dp" />

        <TextView
            android:id="@+id/todo_card"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/home_card_background"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:textColor="@color/on_surface_dark"
            android:textSize="14sp"
            android:visibility="gone" />

        <GridLayout
            android:id="@+id/tile_grid"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginTop="6dp"
            android:alignmentMode="alignMargins"
            android:columnCount="4"
            android:rowCount="2"
            android:useDefaultMargins="false">

            <Button android:id="@+id/tile_note" style="@style/HomeTile" android:layout_columnWeight="1" android:layout_rowWeight="1" android:drawableTop="@drawable/ic_note" android:text="Note" />
            <Button android:id="@+id/tile_event" style="@style/HomeTile" android:layout_columnWeight="1" android:layout_rowWeight="1" android:drawableTop="@drawable/ic_event" android:text="Event" />
            <Button android:id="@+id/tile_clock" style="@style/HomeTile" android:layout_columnWeight="1" android:layout_rowWeight="1" android:drawableTop="@drawable/ic_clock" android:text="Clock" />
            <Button android:id="@+id/tile_todo" style="@style/HomeTile" android:layout_columnWeight="1" android:layout_rowWeight="1" android:drawableTop="@drawable/ic_todo" android:text="To Do" />
            <Button android:id="@+id/tile_call" style="@style/HomeTile" android:layout_columnWeight="1" android:layout_rowWeight="1" android:drawableTop="@drawable/ic_call" android:text="Call" />
            <Button android:id="@+id/tile_message" style="@style/HomeTile" android:layout_columnWeight="1" android:layout_rowWeight="1" android:drawableTop="@drawable/ic_message" android:text="Message" />
            <Button android:id="@+id/tile_camera" style="@style/HomeTile" android:layout_columnWeight="1" android:layout_rowWeight="1" android:drawableTop="@drawable/ic_camera" android:text="Camera" />
            <Button android:id="@+id/tile_memo" style="@style/HomeTile" android:layout_columnWeight="1" android:layout_rowWeight="1" android:drawableTop="@drawable/ic_memo" android:text="Memo" />
        </GridLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/AppDrawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_dark"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/search_bar_background"
            android:hint="@string/drawer_empty"
            android:imeOptions="actionGo"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="@color/on_surface_dark"
            android:textColorHint="@color/outline_dark" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <TextView
                android:id="@+id/drawer_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/drawer_empty"
                android:textColor="@color/outline_dark"
                android:textSize="16sp" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/save_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/save_pill_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@color/on_surface_dark"
        android:visibility="gone" />
</FrameLayout>
