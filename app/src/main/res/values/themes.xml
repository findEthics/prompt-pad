<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/on_surface_dark</item>
        <item name="colorPrimaryDark">@color/surface_dark</item>
        <item name="colorAccent">@color/command_accent</item>
        <item name="colorControlNormal">@color/on_surface_dark</item>
        <item name="colorControlActivated">@color/command_accent</item>
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="fontFamily">@font/lato</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="AppTheme.InvertedDark" parent="AppTheme" />

    <style name="HomeTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/home_tile_background</item>
        <item name="android:textColor">@color/on_surface_dark</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="fontFamily">@font/lato</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">false</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">4dp</item>
    </style>
</resources>
