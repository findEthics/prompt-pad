<?xml version="1.0" encoding="utf-8"?>
<!-- res/values/themes.xml -->
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/on_surface_light</item>
        <item name="colorPrimaryDark">@color/surface_light</item>
        <item name="colorAccent">@color/command_accent</item>
        <item name="colorControlNormal">@color/outline_light</item>
        <item name="android:colorBackground">@color/surface_light</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="AppTheme.InvertedDark" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/on_surface_dark</item>
        <item name="colorPrimaryDark">@color/surface_dark</item>
        <item name="colorAccent">@color/command_accent</item>
        <item name="colorControlNormal">@color/outline_dark</item>
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
</resources>
